# Copy to .env and fill in. .env is gitignored; this template is not.

# Which model Scout uses — "provider:model". This is the MODEL, not the host.
#   ollama:qwen3.5:9b            local, free, weak at tool calling
#   anthropic:claude-opus-5      first-party Claude API
#   foundry:claude-sonnet-4-6    Claude via Microsoft Foundry
PAL_MODEL=ollama:qwen3.5:9b

# --- provider: anthropic (first-party API) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- provider: foundry (Microsoft Foundry) ---
# Separate credential set: ANTHROPIC_API_KEY is NOT used by the Foundry client.
# ANTHROPIC_FOUNDRY_API_KEY=...
#
# RESOURCE is your Azure resource NAME, not a model — it becomes the hostname:
#     https://<RESOURCE>.services.ai.azure.com/anthropic/
# Take the first label of your Foundry endpoint URL. No scheme, no dots, no path.
#     endpoint https://my-team-foundry.services.ai.azure.com/...
#          ->  ANTHROPIC_FOUNDRY_RESOURCE=my-team-foundry
# The model (claude-sonnet-4-6) goes in PAL_MODEL above, never here.
# ANTHROPIC_FOUNDRY_RESOURCE=my-team-foundry
#
# If your endpoint doesn't fit that pattern, set the full URL instead.
# RESOURCE and BASE_URL are mutually exclusive — setting both is an error.
# ANTHROPIC_FOUNDRY_BASE_URL=https://your-endpoint/anthropic/
