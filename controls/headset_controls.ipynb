   "source": [
    "from pynput import keyboard\n",
    "\n",
    "def on_press(key):\n",
    "    print(f\"Pressed: {key}\")\n",
    "\n",
    "def on_release(key):    \n",
    "    print(f\"Released: {key}\")\n",
    "\n",
    "with keyboard.Listener(on_press=on_press, on_release=on_release) as listener:\n",
    "    listener.join()"
